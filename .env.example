# Copy this file to .env and fill in your key. The .env file is gitignored.
# Register for a free MTA Bus Time developer key at the MTA developer site.
BUS_TIME_API_KEY=your-key-here

# NJ Transit Rail (15a). Register for free RailData API access at the NJ Transit
# developer portal (https://developer.njtransit.com), then put the account's own
# username and password here: unlike the MTA, NJ Transit issues no long-lived API
# key. The app exchanges these for a short-lived token at runtime, and that token
# rides as a form field on every request.
#
# LEAVING THESE UNSET IS A SUPPORTED CONFIGURATION. With no credentials the NJ
# Transit layer reports "not-configured" on /api/status, makes NO network call of
# any kind (no token mint, no retry loop), and nothing else in the app is affected.
# Minting is rate-limited below the data cap and the limit is unpublished, which is
# exactly why an unconfigured deployment must never attempt one.
NJT_USERNAME=your-njt-username
NJT_PASSWORD=your-njt-password

# Nothing else is required. Every upstream endpoint, a handful of cadence
# constants, and the on-disk data root also accept an override here; SEAM_NAMES in
# backend/env_seams.py is the complete list. They exist for pointing a feed at a
# mirror and for the contract test tier, and each defaults to the production value,
# so leaving them unset is the supported configuration. Setting one makes the
# contract monitor refuse to run, on purpose: its job is to watch the real
# upstreams, and it cannot do that through a redirect. The two NJT credentials
# above are deliberately NOT seams: the monitor needs them SET to check the real
# upstream, exactly like BUS_TIME_API_KEY.

# Copy this file to .env and fill in your key. The .env file is gitignored.
# Register for a free MTA Bus Time developer key at the MTA developer site.
BUS_TIME_API_KEY=your-key-here

# Nothing else is required. Every upstream endpoint and cadence constant also
# accepts an override here (see backend/env_seams.py); they exist for pointing a
# feed at a mirror and for the contract test tier, and each one defaults to the
# production value, so leaving them unset is the supported configuration.
